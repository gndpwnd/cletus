# Application Settings
APP_NAME="Cletus News Aggregator"
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database
DATABASE_URL=sqlite+aiosqlite:///./cletus.db

# Scraping Configuration
SCRAPING_TIMEOUT=10
SCRAPING_MAX_RETRIES=3
SCRAPING_DELAY=1.0

# Data Retention
HISTORY_RETENTION_DAYS=10
BLACKLIST_RETENTION_DAYS=30

# Analysis Settings
MIN_HEADLINE_WORDS=5
DUPLICATE_CHECK_ENABLED=True

# Scheduling
MORNING_SCRAPE_HOUR=9
EVENING_SCRAPE_HOUR=21
SCRAPE_TIMEZONE=America/New_York